{
  "name": "@podman-desktop/eslint-config",
  "version": "0.0.1",
  "description": "Shared ESLint config enforcing @podman-desktop's code style",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config --cache . --cache-strategy content --fix",
    "lint:check": "eslint --flag unstable_native_nodejs_ts_config --cache . --cache-strategy content",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": ">=10"
  },
  "devDependencies": {
    "@types/node": "^25",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
